<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="66dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/homeProfileEntry"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_home_icon_circle"
                android:clipToOutline="true"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/homeAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="User avatar"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/homeAvatarInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Y"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/homeProfileStatusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="right|bottom"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_profile_dot_online" />
            </FrameLayout>

            <Space android:layout_width="1dp" android:layout_height="6dp" />

            <LinearLayout
                android:layout_width="66dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_glass"
                android:orientation="vertical"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/homeNavHome"
                    android:layout_width="58dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_home_nav_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="27dp" android:contentDescription="front page" android:gravity="bottom|center_horizontal" android:src="@drawable/ic_nav_home" android:scaleType="fitCenter" />
                    <TextView android:layout_width="match_parent" android:layout_height="18dp" android:gravity="top|center_horizontal" android:text="front page" android:textColor="#FFFFFFFF" android:textSize="9sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeNavLibrary"
                    android:layout_width="58dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="3dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="27dp" android:contentDescription="game library" android:gravity="bottom|center_horizontal" android:src="@drawable/ic_nav_library" android:scaleType="fitCenter" />
                    <TextView android:layout_width="match_parent" android:layout_height="18dp" android:gravity="top|center_horizontal" android:text="game library" android:textColor="#E8FFFFFF" android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeNavBigScreen"
                    android:layout_width="58dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="3dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="27dp" android:contentDescription="Large screen mode" android:gravity="bottom|center_horizontal" android:src="@drawable/ic_nav_bigscreen" android:scaleType="fitCenter" />
                    <TextView android:layout_width="match_parent" android:layout_height="18dp" android:gravity="top|center_horizontal" android:text="Large screen mode" android:textColor="#E8FFFFFF" android:textSize="9sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/homeNavChat"
                    android:layout_width="58dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="3dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView android:layout_width="22dp" android:layout_height="27dp" android:contentDescription="好友/聊天" android:gravity="bottom|center_horizontal" android:src="@drawable/ic_nav_chat" android:scaleType="fitCenter" />
                        <TextView android:layout_width="match_parent" android:layout_height="18dp" android:gravity="top|center_horizontal" android:text="好友/聊天" android:textColor="#E8FFFFFF" android:textSize="8sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/homeNavChatBadge"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="1dp"
                        android:layout_marginEnd="1dp"
                        android:gravity="center"
                        android:textColor="#FFFFFFFF"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_unread_badge"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/homeNavTranslate"
                    android:layout_width="58dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="3dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="27dp" android:contentDescription="translate" android:gravity="bottom|center_horizontal" android:src="@drawable/ic_nav_translate" android:scaleType="fitCenter" />
                    <TextView android:layout_width="match_parent" android:layout_height="18dp" android:gravity="top|center_horizontal" android:text="translate" android:textColor="#E8FFFFFF" android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="❄ YukiHub" android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:id="@+id/homeGreeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Welcome back, Yuki" android:textColor="#D9FFFFFF" android:textSize="9sp" />
                </LinearLayout>

                <!-- Gal 工具箱：图标由原 favicon.ico 无损转为 PNG，不加 tint -->
                <FrameLayout
                    android:id="@+id/homeGalToolbox"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bg_home_glass"
                    android:contentDescription="Gal Toolbox"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:contentDescription="Gal Toolbox" android:scaleType="fitCenter" android:src="@drawable/ic_galtoolbox" />
                </FrameLayout>

                <!-- M0：3D 展厅入口（离线个人展厅 / 在线多人展厅） -->
                <FrameLayout
                    android:id="@+id/homeExhibition"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bg_home_glass"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:contentDescription="exhibition hall" android:src="@drawable/ic_home_exhibition" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/homeCommunity"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_home_glass"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:contentDescription="Community" android:src="@drawable/ic_home_community" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/homeNavSettings"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/bg_home_glass"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:contentDescription="set up" android:src="@drawable/ic_nav_settings" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.6"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/homeHeroCard"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_glass"
                        android:clipToOutline="true">

                        <ImageView android:id="@+id/homeHeroCover" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Carousel of recent game covers" android:scaleType="centerCrop" android:src="@drawable/ic_launcher_foreground" />
                        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_home_hero_overlay" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:gravity="bottom|center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:id="@+id/homeHeroTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Start your gaming journey" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" />
                                <TextView android:id="@+id/homeHeroSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Add or select a game from the game library" android:textColor="#E8FFFFFF" android:textSize="9sp" />
                            </LinearLayout>

                            <TextView android:id="@+id/homeHeroAction" android:layout_width="108dp" android:layout_height="40dp" android:background="@drawable/bg_home_action_glass" android:clickable="true" android:focusable="true" android:gravity="center" android:text="continue game" android:textColor="#FFFFFFFF" android:textSize="10sp" android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout android:id="@+id/homeHeroDots" android:layout_width="match_parent" android:layout_height="12dp" android:gravity="center" android:orientation="horizontal" />
                    <TextView android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center_vertical" android:text="quick start" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />

                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="84dp" android:layout_marginTop="3dp" android:fillViewport="false" android:overScrollMode="never" android:scrollbars="none">
                        <LinearLayout android:id="@+id/homeQuickGames" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1.1"
                    android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_home_glass" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="16dp" android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_st_chart" android:tint="#FFFFFFFF" android:contentDescription="Today's data" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="Today's data" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp" android:layout_weight="1" android:orientation="horizontal">
                            <TextView android:id="@+id/homePlayTime" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_home_glass" android:gravity="center" android:text="Today’s play\n0h 0m" android:textColor="#FFFFFFFF" android:textSize="10sp" android:textStyle="bold" />
                            <TextView android:id="@+id/homeGameCount" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_home_glass" android:gravity="center" android:text="Game library\n0 models" android:textColor="#FFFFFFFF" android:textSize="10sp" android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp" android:layout_weight="1" android:orientation="horizontal">
                            <TextView android:id="@+id/homeCompletedCount" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_home_glass" android:gravity="center" android:text="Played \n0" android:textColor="#FFFFFFFF" android:textSize="10sp" android:textStyle="bold" />
                            <TextView android:id="@+id/homePlayingCount" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_home_glass" android:gravity="center" android:text="Currently playing \n0" android:textColor="#FFFFFFFF" android:textSize="10sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/homeNewsCard" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp" android:layout_weight="1" android:background="@drawable/bg_home_glass" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                                <ImageView android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_st_news" android:tint="#FFFFFFFF" android:contentDescription="Galgame information" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="Galgame information" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" />
                            </LinearLayout>
                            <ImageView android:id="@+id/homeNewsRefresh" android:layout_width="32dp" android:layout_height="match_parent" android:clickable="true" android:focusable="true" android:contentDescription="Refresh information" android:padding="2dp" android:scaleType="fitCenter" android:src="@drawable/ic_st_refresh" android:tint="#B3FFFFFF" />
                        </LinearLayout>
                        <FrameLayout android:id="@+id/homeNewsMedia" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="4dp" android:layout_weight="1">
                            <ImageView android:id="@+id/homeNewsBanner" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Information question map" android:scaleType="centerCrop" android:visibility="gone" />
                            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_home_news_overlay" />
                            <TextView android:id="@+id/homeNewsLoading" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Getting information…" android:textColor="#B3FFFFFF" android:textSize="9sp" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingBottom="6dp">
                                <TextView android:id="@+id/homeNewsTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:text="" android:textColor="#FFFFFFFF" android:textSize="10sp" android:textStyle="bold" />
                                <LinearLayout android:id="@+id/homeNewsDots" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="2dp" android:gravity="center" android:orientation="horizontal" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>