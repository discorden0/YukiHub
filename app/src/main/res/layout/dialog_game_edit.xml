<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView android:id="@+id/editDialogTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="add game" android:textColor="@color/yh_text" android:textSize="22sp" android:textStyle="bold" />
<androidx.appcompat.widget.AppCompatEditText android:id="@+id/etGameTitle" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp" android:hint="game title" android:singleLine="true" android:textColor="@color/yh_text" android:textColorHint="@color/yh_text_muted" android:background="@drawable/bg_input" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Game engine type" android:textColor="@color/yh_text" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/bg_label" />
        <com.yuki.yukihub.ui.TapSafeSpinner android:id="@+id/spEngine" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:background="@drawable/bg_input" />

        <LinearLayout android:id="@+id/layoutArtemisVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Artemis compatible version" android:textColor="@color/yh_text" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/bg_label" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnArtemisAuto" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:text="automatic" android:textAllCaps="false" android:background="@drawable/bg_action_tool" android:textColor="@color/yh_action_tool_text" android:tag="yh.action.filter" app:backgroundTint="@null" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnArtemisStd" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="standard" android:textAllCaps="false" android:background="@drawable/bg_action_tool" android:textColor="@color/yh_action_tool_text" android:tag="yh.action.filter" app:backgroundTint="@null" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnArtemisCompat" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="compatible" android:textAllCaps="false" android:background="@drawable/bg_action_tool" android:textColor="@color/yh_action_tool_text" android:tag="yh.action.filter" app:backgroundTint="@null" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnArtemisCompatV2" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Compatible with V2" android:textAllCaps="false" android:background="@drawable/bg_action_tool" android:textColor="@color/yh_action_tool_text" android:tag="yh.action.filter" app:backgroundTint="@null" />
</LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/tvLaunchTargetLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="启动文件 / 启动入口（从游戏目录真实扫描）" android:textColor="@color/yh_text" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/bg_label" />
        <com.yuki.yukihub.ui.TapSafeSpinner android:id="@+id/spLaunchTarget" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:background="@drawable/bg_input" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:orientation="horizontal">
<androidx.appcompat.widget.AppCompatEditText android:id="@+id/etEmulatorPackage" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:hint="Simulator application, optional" android:singleLine="true" android:focusable="false" android:clickable="true" android:textColor="@color/yh_text" android:textColorHint="@color/yh_text_muted" android:background="@drawable/bg_input" />
<TextView android:id="@+id/btnResetEmulatorPackage" android:layout_width="88dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:gravity="center" android:background="@drawable/bg_action_tool" android:foreground="?android:attr/selectableItemBackgroundBorderless" android:text="default" android:textColor="@color/yh_action_tool_text" android:textSize="12sp" android:textStyle="bold" android:tag="yh.action.tool" />
<TextView android:id="@+id/btnPickEmulatorApp" android:layout_width="88dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:gravity="center" android:background="@drawable/bg_action_tool" android:foreground="?android:attr/selectableItemBackgroundBorderless" android:text="Select app" android:textColor="@color/yh_action_tool_text" android:textSize="12sp" android:textStyle="bold" android:tag="yh.action.tool" />
</LinearLayout>
<LinearLayout android:id="@+id/layoutWinlatorLaunchMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:visibility="gone">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Winlator startup method" android:textColor="@color/yh_text" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/bg_label" />
<com.yuki.yukihub.ui.TapSafeSpinner android:id="@+id/spWinlatorLaunchMode" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:background="@drawable/bg_input" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Boot into the game: boot directly by default; boot into the program: only enter the Winlator interface." android:textColor="@color/yh_text_muted" android:textSize="10sp" />
</LinearLayout>
<LinearLayout android:id="@+id/layoutGameHubLaunch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:visibility="gone">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GameHub Direct Launch" android:textColor="@color/yh_text" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/bg_label" />
<com.yuki.yukihub.ui.TapSafeSpinner android:id="@+id/spGameHubLaunchMode" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:background="@drawable/bg_input" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Boot into the game: You need the patched version of GameHub and fill in the localGameId; Boot into the program: Only open GameHub." android:textColor="@color/yh_text_muted" android:textSize="10sp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:orientation="horizontal">
<androidx.appcompat.widget.AppCompatEditText android:id="@+id/etGameHubLocalGameId" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:hint="local_xxxxx or steam:123456" android:singleLine="true" android:textColor="@color/yh_text" android:textColorHint="@color/yh_text_muted" android:background="@drawable/bg_input" />
<TextView android:id="@+id/btnPickGameHubShortcut" android:layout_width="104dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:gravity="center" android:background="@drawable/bg_action_tool" android:foreground="?android:attr/selectableItemBackgroundBorderless" android:text="Import shortcuts" android:textColor="@color/yh_action_tool_text" android:textSize="12sp" android:textStyle="bold" android:tag="yh.action.tool" />
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Parameters can be imported from desktop shortcuts that GameHub has created." android:textColor="@color/yh_text_muted" android:textSize="10sp" />
</LinearLayout>
<androidx.appcompat.widget.AppCompatEditText android:id="@+id/etDescription" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="10dp" android:hint="Remarks, optional" android:gravity="top" android:textColor="@color/yh_text" android:textColorHint="@color/yh_text_muted" android:background="@drawable/bg_input" />

        <LinearLayout android:id="@+id/layoutDirRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tvSelectedDir" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="No game directory selected" android:textColor="@color/yh_text_muted" android:textSize="12sp" android:maxLines="2" android:ellipsize="middle" />
            <TextView android:id="@+id/btnClearDir" android:layout_width="88dp" android:layout_height="38dp" android:layout_marginStart="8dp" android:gravity="center" android:background="@drawable/bg_action_tool" android:foreground="?android:attr/selectableItemBackgroundBorderless" android:text="clear directory" android:textColor="@color/yh_action_tool_text" android:textSize="12sp" android:textStyle="bold" android:tag="yh.action.tool" />
        </LinearLayout>
        <TextView android:id="@+id/tvSelectedCover" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="No cover selected" android:textColor="@color/yh_text_muted" android:textSize="12sp" android:maxLines="2" android:ellipsize="middle" />

        <TextView android:id="@+id/tvPlayTimeInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Total duration: 0 minutes" android:textColor="@color/yh_text_muted" android:textSize="12sp" android:visibility="gone" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPickDir" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Select directory" android:textAllCaps="false" android:background="@drawable/bg_action_tool" android:textColor="@color/yh_action_tool_text" android:tag="yh.action.tool" app:backgroundTint="@null" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPickCover" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Select cover" android:textAllCaps="false" android:background="@drawable/bg_action_tool" android:textColor="@color/yh_action_tool_text" android:tag="yh.action.tool" app:backgroundTint="@null" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCancel" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Cancel" android:textAllCaps="false" android:background="@drawable/bg_action_tool" android:textColor="@color/yh_action_tool_text" android:tag="yh.action.tool" app:backgroundTint="@null" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnSave" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="save" android:textAllCaps="false" android:background="@drawable/bg_action_primary" android:textColor="@color/yh_action_primary_text" android:tag="yh.action.primary" app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>